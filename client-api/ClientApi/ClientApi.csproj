<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 生成接口 XML 文档，供 Swagger 展示中文说明。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="2.0.15" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="RestSharp" Version="110.2.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
  </ItemGroup>

  <!-- YAML 配置随编译和发布复制，供部署后编辑并热重载。 -->
  <ItemGroup>
    <Content Include="appsettings*.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 指静脉原生 SDK 及协议库随构建和发布复制，保持 P/Invoke 使用的 Vein 子目录。 -->
  <ItemGroup>
    <None Update="Vein\*.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 随项目复制独立识别运行环境，不复制业务身份库。 -->
  <ItemGroup>
    <Compile Remove="FaceRecognition\runtime\**\*" />
    <Content Remove="FaceRecognition\runtime\**\*;FaceRecognition\backend\**\*;FaceRecognition\data\**\*" />
    <None Remove="FaceRecognition\runtime\**\*;FaceRecognition\backend\**\*;FaceRecognition\data\**\*" />
    <Content Include="FaceRecognition\backend\**\*.py;FaceRecognition\runtime\**\*;FaceRecognition\data\models\**\*;FaceRecognition\requirements.lock.txt"
             Exclude="FaceRecognition\**\__pycache__\**;FaceRecognition\**\*.pyc"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireFaceRuntimeForPublish" BeforeTargets="PrepareForPublish"
          Condition="'$(SkipFaceRuntimeCheck)' != 'true'">
    <Error Condition="!Exists('FaceRecognition/runtime/python.exe')"
           Text="请先执行 scripts/prepare-face-runtime.ps1，准备独立发布需要的人脸识别运行环境。" />
  </Target>

</Project>
