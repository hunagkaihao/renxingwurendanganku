# humanoid-archive-wms API serving /api/abp/application-configuration.
# Leave unset when the API runs on the same machine as the web page at port 5000.
# For a separate server, copy this file to .env.development or .env.production
# and set its reachable HTTP(S) address.
VUE_APP_REMOTE_SERVICE_BASE_URL=http://127.0.0.1:5000/
# 仅启动 WMS 时设为 true；开发环境默认 true，生产环境默认 false。
# false 仍使用旧设备接口，并不表示已完成新 WMS 的设备业务适配。
VUE_APP_WMS_ONLY=true
